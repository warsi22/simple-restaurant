@model List<Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Orders</h1>
    <a class="btn btn-restaurant" asp-action="Create">+ New Order</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No orders yet. <a asp-action="Create">Create the first order</a>.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th class="text-center">Items</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-center">@order.OrderItems.Sum(item => item.Quantity)</td>
                            <td><partial name="_StatusBadge" model="order.Status" /></td>
                            <td class="text-end">@order.TotalAmount.ToString("C")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
