@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Order #@Model.Id</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Orders</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel">
            <dl class="row">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@Model.CustomerName</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><partial name="_StatusBadge" model="Model.Status" /></dd>
            </dl>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.MenuItem?.Name</td>
                                @* UnitPrice is the price saved when the order was placed, not today's menu price. *@
                                <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end fs-5">@Model.TotalAmount.ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <h2 class="h5 mb-3">Change Status</h2>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                <select name="status" class="form-select mb-3">
                    @foreach (var status in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status</option>
                    }
                </select>
                <button type="submit" class="btn btn-restaurant w-100">Update Status</button>
            </form>
        </div>
    </div>
</div>
