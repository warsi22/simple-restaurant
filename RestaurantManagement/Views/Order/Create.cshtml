@using System.Globalization
@model CreateOrderViewModel
@{
    ViewData["Title"] = "New Order";
}

<h1 class="page-title mb-4">New Order</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="panel mb-3" style="max-width: 640px;">
        <label asp-for="CustomerName" class="form-label"></label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="panel mb-3">
        <h2 class="h5 mb-3">Choose menu items</h2>

        @if (Model.Lines.Count == 0)
        {
            <p class="text-muted mb-0">There are no available menu items. <a asp-controller="Menu" asp-action="Create">Add one first</a>.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Category</th>
                            <th class="text-end">Price</th>
                            <th>Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* A "for" loop (not foreach) gives each input an indexed name such as Lines[2].Quantity,
                           which lets model binding rebuild the List<OrderLineViewModel> on the server. *@
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="Lines[i].MenuItemId" />
                                    @Model.Lines[i].Name
                                </td>
                                <td>@Model.Lines[i].CategoryName</td>
                                <td class="text-end">@Model.Lines[i].Price.ToString("C")</td>
                                <td>
                                    <input asp-for="Lines[i].Quantity" class="form-control quantity-input js-quantity"
                                           type="number" min="0" max="50"
                                           data-price="@Model.Lines[i].Price.ToString(CultureInfo.InvariantCulture)" />
                                    <span asp-validation-for="Lines[i].Quantity" class="text-danger small"></span>
                                </td>
                                <td class="text-end js-subtotal">€0.00</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-end">Total</th>
                            <th class="text-end fs-5" id="orderTotal">€0.00</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-restaurant">Place Order</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Shows a live preview of the total while the user types.
        // This is only for convenience: the real total is calculated again on the server
        // from the prices stored in the database.
        const euro = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR' });

        function updateTotals() {
            let total = 0;
            document.querySelectorAll('.js-quantity').forEach(function (input) {
                const quantity = parseInt(input.value) || 0;
                const subtotal = quantity * parseFloat(input.dataset.price);
                input.closest('tr').querySelector('.js-subtotal').textContent = euro.format(subtotal);
                total += subtotal;
            });
            document.getElementById('orderTotal').textContent = euro.format(total);
        }

        document.querySelectorAll('.js-quantity').forEach(function (input) {
            input.addEventListener('input', updateTotals);
        });

        if (document.getElementById('orderTotal')) {
            updateTotals();
        }
    </script>
}
