@model Category
@{
    ViewData["Title"] = "Delete Category";
}

<h1 class="page-title mb-4">Delete Category</h1>

@if (Model.MenuItems.Count > 0)
{
    <div class="alert alert-danger" style="max-width: 640px;">
        <strong>@Model.Name</strong> still contains @Model.MenuItems.Count menu item(s), so it cannot be deleted.
        Move those items to another category or delete them first.
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Categories</a>
}
else
{
    <div class="alert alert-warning" style="max-width: 640px;">
        Are you sure you want to delete the category <strong>@Model.Name</strong>?
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Yes, delete it</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
}
