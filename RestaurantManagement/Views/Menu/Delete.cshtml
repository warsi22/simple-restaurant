@model MenuItem
@{
    ViewData["Title"] = "Delete Menu Item";
}

<h1 class="page-title mb-4">Delete Menu Item</h1>

<div class="alert alert-warning" style="max-width: 640px;">
    Are you sure you want to delete <strong>@Model.Name</strong>? This cannot be undone.
</div>

<div class="panel mb-3" style="max-width: 640px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Category</dt>
        <dd class="col-sm-8">@Model.Category?.Name</dd>

        <dt class="col-sm-4">Price</dt>
        <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
    </dl>
</div>

@* Deleting changes data, so it must be a POST request with an anti-forgery token, never a plain link. *@
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Yes, delete it</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
