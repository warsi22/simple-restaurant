@* A strongly typed view: @model tells Razor the type of data that MenuController passes in. *@
@model List<MenuItem>
@{
    ViewData["Title"] = "Menu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title mb-0">Menu</h1>
    <a class="btn btn-restaurant" asp-action="Create">+ Add Menu Item</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">The menu is empty. Add your first item!</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th class="text-end">Price</th>
                        <th>Available</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* Razor mixes C# (@foreach) with HTML: one table row per menu item. *@
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Name</strong>
                                <div class="small text-muted">@item.Description</div>
                            </td>
                            <td>@item.Category?.Name</td>
                            <td class="text-end">@item.Price.ToString("C")</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @* Tag helpers build the URLs, e.g. /Menu/Edit/3 *@
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
