@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="page-title mb-4">Dashboard</h1>

<!-- Four Bootstrap cards. Each number comes from the DashboardViewModel built in HomeController. -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon">🍔</span>
                <div>
                    <div class="text-muted">Menu Items</div>
                    <div class="stat-value">@Model.TotalMenuItems</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon">📂</span>
                <div>
                    <div class="text-muted">Categories</div>
                    <div class="stat-value">@Model.TotalCategories</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon">🧾</span>
                <div>
                    <div class="text-muted">Orders</div>
                    <div class="stat-value">@Model.TotalOrders</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon">💶</span>
                <div>
                    <div class="text-muted">Revenue</div>
                    <div class="stat-value">@Model.TotalRevenue.ToString("C")</div>
                    <small class="text-muted">Excludes cancelled orders</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Recent Orders</h2>
        <a asp-controller="Order" asp-action="Index">View all orders</a>
    </div>

    @if (Model.RecentOrders.Count == 0)
    {
        <p class="text-muted mb-0">
            No orders yet. <a asp-controller="Order" asp-action="Create">Create the first order</a>.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td><a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">@order.Id</a></td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td><partial name="_StatusBadge" model="order.Status" /></td>
                            <td class="text-end">@order.TotalAmount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
